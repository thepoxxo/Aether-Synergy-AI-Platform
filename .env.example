# ==============================================================================
# 👑 AETHER SYNERGY AI PLATFORM - MASTER API KEYS CONFIGURATION (.env)
# ==============================================================================
# Todas las variables de entorno para activar el funcionamiento 100% REAL en vivo
# de generación 3D, videos, música, imágenes, agentes autónomos y pagos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🧠 INTELIGENCIA ARTIFICIAL CENTRAL, J.A.R.V.I.S. & ENJAMBRE DE AGENTES (LLMs)
# ------------------------------------------------------------------------------
# Google Gemini API (Para razonamiento cuántico, fichas técnicas y orquestador Swarm)
# Obtener en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OpenAI API (GPT-4o / Whisper Speech-to-Text para J.A.R.V.I.S.)
# Obtener en: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Anthropic Claude 3.5 Sonnet API (Para validación de moldería CAD industrial y DXF)
# Obtener en: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=


# ------------------------------------------------------------------------------
# 2. 🎮 MODELADO 3D MULTIDISCIPLINARIO & GENERACIÓN DE MALLAS .GLB / .OBJ
# (Ropa, Sillas/Muebles, Calzado, Bolsos, Accesorios y Objetos de Restaurante)
# ------------------------------------------------------------------------------
# Tripo3D API (Text-to-3D, Image-to-3D ultra-rápido con retopología automática)
# Obtener en: https://platform.tripo3d.ai/
VITE_TRIPO3D_API_KEY=

# Meshy AI API (Generación 3D PBR con mapas de textura 4K Albedo/Roughness/Normal)
# Obtener en: https://www.meshy.ai/
VITE_MESHY_API_KEY=

# Rodin (Deemos) / CSM AI (Escaneo y geometría de alta densidad para objetos comerciales)
# Obtener en: https://hyperhuman.deemos.com/rodin
VITE_RODIN_API_KEY=

# Kaedim3D API (Mallas industriales Quad preparadas para manufactura de muebles y bolsos)
# Obtener en: https://www.kaedim3d.com/
VITE_KAEDIM_API_KEY=

# Spline 3D Cloud Rendering API (Ray tracing en tiempo real en WebGPU)
# Obtener en: https://spline.design/
VITE_SPLINE_API_KEY=


# ------------------------------------------------------------------------------
# 3. 🎬 GENERACIÓN DE VIDEO PUBLICITARIO, TURNTABLES 360° & ANUNCIOS CINEMÁTICOS
# (TikTok 9:16, Reels, Anuncios de Moda, Calzado y Comerciales de Restaurantes)
# ------------------------------------------------------------------------------
# Runway Gen-3 Alpha API (Videos hiperrealistas en 4K con control cinemático de cámara)
# Obtener en: https://dev.runwayml.com/
VITE_RUNWAY_API_KEY=

# Luma Dream Machine API (Movimientos dinámicos y loops de 360 grados)
# Obtener en: https://lumalabs.ai/dream-machine/api
VITE_LUMA_API_KEY=

# Kling AI API (Física ultra-realista de telas y personajes humanos en movimiento)
# Obtener en: https://klingai.org/
VITE_KLING_API_KEY=

# Minimax / Hailuo Video AI (Comerciales de alta energía y planos macro de alimentos)
# Obtener en: https://api.minimax.chat/
VITE_MINIMAX_API_KEY=

# Pika Labs 2.0 API (Animaciones de efectos, transiciones de ropa y motion graphics)
# Obtener en: https://pika.art/
VITE_PIKA_API_KEY=


# ------------------------------------------------------------------------------
# 4. 📸 FOTOGRAFÍA EDITORIAL, DIBUJO, VECTORIZACIÓN & BOCETO A RENDER
# (Lookbook Studio, Brand Kit, Letreros de Restaurantes y Parches de Bordado)
# ------------------------------------------------------------------------------
# Fal.ai API (Acceso directo a FLUX.1 Pro / Dev para fotorealismo supremo sin errores de texto)
# Obtener en: https://fal.ai/dashboard/keys
VITE_FAL_KEY=

# Replicate API (FLUX.1, ControlNet Sketch-to-3D, Upscaling 8K)
# Obtener en: https://replicate.com/account/api-tokens
VITE_REPLICATE_API_TOKEN=

# Midjourney API (vía ImagineAPI / GoAPI para sesiones de fotos de alta costura)
# Obtener en: https://www.imagineapi.dev/ o https://goapi.ai/
VITE_MIDJOURNEY_API_KEY=

# Recraft AI API (Generación de vectores SVG puros, iconos de marca y parches bordados 3.5mm)
# Obtener en: https://www.recraft.ai/
VITE_RECRAFT_API_KEY=

# Stability AI API (SDXL Turbo & ControlNet para bocetos a mano)
# Obtener en: https://platform.stability.ai/
VITE_STABILITY_API_KEY=


# ------------------------------------------------------------------------------
# 5. 🎵 MÚSICA COMERCIAL, BANDAS SONORAS, EFECTOS DE SONIDO & LOCUCIÓN
# (Jingles para TikTok, Música de Fondo para Restaurantes y Voz de J.A.R.V.I.S.)
# ------------------------------------------------------------------------------
# Suno AI API / Udio API (Generación de música instrumental y comercial completa)
# Obtener en: https://suno.com/ o https://topmediai.com/
VITE_SUNO_MUSIC_API_KEY=

# ElevenLabs Enterprise Voice API (Locuciones en 29 idiomas, clonación de voz y J.A.R.V.I.S.)
# Obtener en: https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_API_KEY=


# ------------------------------------------------------------------------------
# 6. ☁️ BASE DE DATOS, AUTENTICACIÓN & BUCKET DE ALMACENAMIENTO CLOUD (3D VAULT)
# (Guardar Proyectos, Cuentas de Usuarios, Mallas .GLB y Webhooks en la Nube)
# ------------------------------------------------------------------------------
# Supabase Backend (PostgreSQL en tiempo real + Auth + Storage)
# Obtener en: https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare R2 / AWS S3 (Almacenamiento global CDN ilimitado para modelos 3D y texturas 8K)
# Obtener en: https://dash.cloudflare.com/
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET_NAME=
VITE_R2_PUBLIC_URL=


# ------------------------------------------------------------------------------
# 7. 💳 PASARELA DE PAGOS (SUSCRIPCIONES SAAS) & CONEXIÓN SHOPIFY E-COMMERCE
# (Planes Pro $49/mo, Agencia $149/mo y Publicación de Productos en Tiendas)
# ------------------------------------------------------------------------------
# Stripe API (Suscripciones con tarjeta de crédito/débito internacionales)
# Obtener en: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=

# LemonSqueezy API (Alternativa sin fricción con Merchant of Record global)
# Obtener en: https://app.lemonsqueezy.com/settings/api
VITE_LEMONSQUEEZY_API_KEY=

# Shopify Admin API (Exportación directa de landings y productos con 1 clic)
# Obtener en: https://partners.shopify.com/
VITE_SHOPIFY_API_KEY=
VITE_SHOPIFY_API_SECRET=
